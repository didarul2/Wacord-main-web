# Copy to .env.local (do not commit secrets)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Meta App Dashboard → Settings → Basic → App Secret
# Used by /api/meta-data-deletion callback signature verification
META_APP_SECRET=

# Public site origin used in Meta deletion status URLs
PUBLIC_SITE_URL=https://wacord.com
